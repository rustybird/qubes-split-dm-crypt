#!/bin/bash
set -e -o pipefail

PATH=/usr/local/etc:/etc source split-dm-crypt.conf

case $1 in
    encrypted) dev=$DEVICE ;;
    decrypted) dev=/dev/mapper/$MAP_NAME ;;
            *) exit 1 ;;
esac

udevadm settle

mm=$(stat -L -c %Hr:%Lr -- "$dev")
exec </run/udev/data/b"$mm"
if grep -E '^E:ID_FS_(TYPE|USAGE)='; then exit 1; fi
