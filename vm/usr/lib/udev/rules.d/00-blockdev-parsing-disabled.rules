SUBSYSTEM!="block", GOTO="end"

# initialize flags on add event
ACTION!="add", GOTO="assign_end"
PROGRAM="/bin/cat /sys/module/block/parameters/no_part_scan", RESULT=="N", GOTO="assign_end"
ENV{UDEV_DISABLE_PERSISTENT_STORAGE_RULES_FLAG}="1"
ENV{DM_NOSCAN}="1"
ENV{UDISKS_IGNORE}="1"
LABEL="assign_end"

# keep those flags active in subsequent events
ACTION=="add", GOTO="import_end"
IMPORT{db}="UDEV_DISABLE_PERSISTENT_STORAGE_RULES_FLAG"
IMPORT{db}="DM_NOSCAN"
IMPORT{db}="UDISKS_IGNORE"
LABEL="import_end"

LABEL="end"
